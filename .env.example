# ==============================================================
# EditMind AI - Environment Configuration Template
# Copy this file to .env and fill in your API keys:
#   copy .env.example .env
# ==============================================================

# 1. Claude Fable 5.1 (Anthropic Frontier Model) - Recommended
# Powers AI Multi-Video Auto-Assembly and EditAI Assistant Co-Pilot
FABLE_API_KEY=your_fable_or_anthropic_api_key_here
ANTHROPIC_API_KEY=
FABLE_MODEL=claude-fable-5-1

# 2. Google Gemini API (Alternative)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# 3. OpenAI / Groq API (Alternative)
OPENAI_API_KEY=
GROQ_API_KEY=

# 4. Local Ollama (Offline Local LLMs)
OLLAMA_HOST=http://localhost:11434

# 5. Server Configuration
HOST=0.0.0.0
PORT=8000
